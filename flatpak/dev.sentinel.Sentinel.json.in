{
  "app-id": "dev.sentinel.Sentinel",
  "runtime": "org.kde.Platform",
  "runtime-version": "@FLATPAK_RUNTIME@",
  "sdk": "org.kde.Sdk",
  "command": "sentinel-desktop",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "--filesystem=xdg-config/Sentinel:create",
    "--filesystem=xdg-data/Sentinel:create",
    "--filesystem=xdg-documents/Sentinel:create",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.secrets"
  ],
  "modules": [
    {
      "name": "sentinel-desktop",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DSENTINEL_APP_VERSION=@APP_VERSION@",
        "-DSENTINEL_APP_ID=dev.sentinel.Sentinel",
        "-DSENTINEL_BUILD_TESTS=OFF",
        "-DSENTINEL_USE_CCACHE=OFF",
        "-DCMAKE_INSTALL_SYSCONFDIR=/app/etc"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "@SOURCE_URL@",
          "sha256": "@SOURCE_SHA256@"
        }
      ]
    }
  ]
}
